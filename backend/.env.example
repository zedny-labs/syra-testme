# ──────────────────────────────────────────────
# SYRA LMS Backend — Environment Configuration
# Copy to backend/.env and fill in your values.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# Optional: use a direct Postgres connection for Alembic migrations while the
# app uses a pooled Supabase URL above.
# DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT_SECONDS=15
# DB_POOL_RECYCLE_SECONDS=1800

# ── Authentication ────────────────────────────
# REQUIRED — at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-32-character-string
JWT_ALGORITHM=HS256

# ── Email (Brevo) ────────────────────────────
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=lms@zedny.ai
BREVO_SENDER_NAME=SYRA LMS
BREVO_SANDBOX=false

# ── AI Features (optional) ───────────────────
OPENAI_API_KEY=

# ── URLs ──────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_APPLY_MIGRATIONS=true
PRECHECK_ALLOW_TEST_BYPASS=false
WEB_REPORT_SCHEDULER_ENABLED=true
E2E_SEED_ENABLED=false

# ── Observability ────────────────────────────
# Optional: Sentry DSN for error tracking. Leave blank to disable.
SENTRY_DSN=

# ── Performance tuning ───────────────────────
THREADPOOL_SIZE=40
MAINTENANCE_CACHE_TTL_SECONDS=300

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO

# ── Data Retention ───────────────────────────
IDENTITY_RETENTION_DAYS=7
PROCTORING_VIDEO_RETENTION_DAYS=90
PROCTORING_EVIDENCE_RETENTION_DAYS=90

# ── Upload Limits ────────────────────────────
MAX_VIDEO_UPLOAD_MB=512

# ── Media Storage ────────────────────────────
MEDIA_STORAGE_PROVIDER=local
PROCTORING_VIDEO_STORAGE_PROVIDER=cloudflare
PROCTORING_INFERENCE_MODE=local
PROCTORING_INFERENCE_QUEUE=proctoring-inference
PROCTORING_INFERENCE_OPEN_TIMEOUT_SECONDS=180
PROCTORING_INFERENCE_TASK_TIMEOUT_SECONDS=30
AI_INFERENCE_URL=http://127.0.0.1:8081
PROCTORING_BATCH_ANALYSIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── Cloudflare Stream (optional) ─────────────
CLOUDFLARE_MEDIA_API_BASE_URL=
CLOUDFLARE_MEDIA_REQUIRE_SIGNED_URLS=true
CLOUDFLARE_MEDIA_WATERMARK_UID=

# ── Supabase Storage (optional) ──────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=syra-media
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600

# ── Vimeo (optional) ─────────────────────────
# Only needed if PROCTORING_VIDEO_STORAGE_PROVIDER=vimeo
VIMEO_ACCESS_TOKEN=
VIMEO_PRIVACY_VIEW=unlisted
VIMEO_FOLDER_ID=
VIMEO_EMBED_DOMAIN=
